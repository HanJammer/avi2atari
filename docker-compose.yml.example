# AVI2ATARI AVF Suite - example compose for a traefik-fronted deployment.
# Copy to docker-compose.yml, copy .env.example to .env, then `docker compose up -d`.
#
# Assumes an existing external traefik network `traefik_public` and that
# traefik terminates TLS. No certresolver is set here (the maintainer runs
# traefik locally with its own certs); uncomment the tls line if yours
# uses one.
services:
  avi2atari:
    build: .
    container_name: avi2atari
    restart: unless-stopped
    env_file: .env
    # scratch is RAM (tmpfs); nothing about a conversion is persisted
    tmpfs:
      - /dev/shm:size=1g
    networks:
      - traefik_public
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=traefik_public"
      - "traefik.http.routers.avi2atari.rule=Host(`${DOMAIN}`)"
      - "traefik.http.routers.avi2atari.entrypoints=websecure"
      # - "traefik.http.routers.avi2atari.tls.certresolver=le"
      - "traefik.http.services.avi2atari.loadbalancer.server.port=8000"

networks:
  traefik_public:
    external: true
