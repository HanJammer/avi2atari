# AVI2ATARI AVF Suite - web service configuration
# Copy to .env and adjust. All values are optional (defaults shown).

# Public hostname for the traefik router (compose).
DOMAIN=avi2atari.rustybits.pl

# Show the "hosted" disclaimer (files not stored; IP + names are logged).
SERVER_MODE=1

# Abuse trail: log client IP + submitted file names / URLs.
LOG_REQUESTS=1

# Allow converting from a URL (YouTube etc.). Needs yt-dlp in the image
# (uncomment it in web/requirements-docker.txt). Off by default.
YOUTUBE_ENABLED=0

# Upload ceiling (MB) and per-job conversion timeout (seconds).
MAX_UPLOAD_MB=512
CONVERT_TIMEOUT=1800
